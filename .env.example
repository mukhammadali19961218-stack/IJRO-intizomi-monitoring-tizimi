# ========================================================
# IJRO INTIZOMI DASHBOARD - ENVIRONMENT CONFIGURATION
# ========================================================

# Application Mode: development / production
APP_ENV=production
DEBUG=False

# Server Port & Host
HOST=0.0.0.0
PORT=8000

# Production Database (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# If left empty, backend falls back safely to local SQLite database (database/dashboard.db)
DATABASE_URL=postgresql://dashboard_user:change_this_strong_password@localhost:5432/ijro_dashboard

# JWT Secret Key & Token Expiry
SECRET_KEY=change_this_to_a_random_secure_64_character_hex_string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin & Viewer Credentials (seeded automatically on startup if accounts do not exist)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change_this_admin_password

INITIAL_VIEWER_USERNAME=viewer
INITIAL_VIEWER_PASSWORD=change_this_viewer_password

# Persistent Storage Paths (relative or absolute)
TASKS_STORAGE_PATH=data/tasks
EMPLOYEE_PHOTO_PATH=data/uploads/employees
